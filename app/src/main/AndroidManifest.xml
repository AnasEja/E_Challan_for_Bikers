<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.e_challan">
    <!-- INTERNET permission must be outside <application> -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.E_challan"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".PaymentActivity2"
            android:exported="false"/>
        <activity
            android:name=".payment_jazz"
            android:exported="false"/>
        <activity
            android:name=".PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".PdfViewActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name=".MyChallansActivity"
            android:exported="false" />
        <activity
            android:name=".ClientHomeActivity"
            android:exported="false" />
        <activity
            android:name=".LivePreviewActivity"
            android:exported="false" />
        <activity
            android:name=".SignIn"
            android:exported="false" />
        <activity
            android:name=".Home"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SignUp"
            android:exported="false" />
    </application>

</manifest>